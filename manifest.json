{
  "manifest_version": 3,
  "name": "IDU+",
  "version": "0.4.0",
  "description": "IDU+ compact, clean and responsive visual redesign for s19.idu.edu.pl. Codex-ready workspace build.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://s19.idu.edu.pl/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://s19.idu.edu.pl/*"
      ],
      "css": [
        "content/idu-modern.css"
      ],
      "js": [
        "content/idu-modern.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "IDU+",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "IDU+"
}
