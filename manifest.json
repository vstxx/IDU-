{
  "manifest_version": 3,
  "name": "IDU+",
  "version": "0.1.0",
  "description": "A modern glassy visual layer for the real IDU portal.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "IDU+ Appearance",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.idu.edu.pl/*"],
      "css": ["src/idu-plus.css"],
      "js": ["src/idu-plus.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://*.idu.edu.pl/*"]
    }
  ]
}
