{
  "name": "idu-plus-diagnostics",
  "main": "./diagnostics-worker.mjs",
  "compatibility_date": "2026-06-25",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "idu-diagnostics.vastbrowser.com",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "DIAGNOSTICS_GLOBAL_RATE_LIMITER",
      "namespace_id": "9033001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "DIAGNOSTICS_CLIENT_RATE_LIMITER",
      "namespace_id": "9033002",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["DISCORD_WEBHOOK_URL"]
  }
}
